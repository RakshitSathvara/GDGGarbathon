{
  "name": "saavdhan",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time mid-call scam warnings in Gujarati and Hindi for elders, powered by Gemini audio understanding.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "node scripts/build.mjs",
    "clean": "node scripts/build.mjs --clean",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "lint": "npm run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test \"tests/node/**/*.test.ts\"",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=\"server/**\" --test-coverage-include=\"static/js/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test \"tests/node/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test \"tests/e2e/**/*.test.ts\"",
    "test:py": "python3 -m pytest"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "axe-core": "^4.14.0",
    "playwright": "1.63.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
