# GEMINI_API_KEY: Required for Gemini AI API calls (read on the server only, never sent to the browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model & detector configuration
MODEL="gemini-3.8-flash"
THINKING_LEVEL="low"
CHUNK_SEC="6.0"
DEMO_REPLAY="0"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server settings (Node)
# PORT="3000"
# HOST="0.0.0.0"
# TRUST_PROXY="1"            # reverse-proxy hops to trust for client IPs (rate limiting)
# FRAME_ANCESTORS="'self'"   # restrict which sites may embed the app (unset = AI Studio preview works)
