{
  "type": "object",
  "properties": {
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker": { "type": "string", "enum": ["CALLER", "RECEIVER", "UNKNOWN"] },
          "text": { "type": "string" }
        },
        "required": ["speaker", "text"]
      }
    },
    "new_red_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "AUTHORITY_CLAIM",
              "URGENCY",
              "THREAT",
              "OTP_OR_CREDENTIALS",
              "MONEY_REQUEST",
              "REMOTE_ACCESS_OR_LINK",
              "SECRECY",
              "HANDOFF_TO_OFFICIAL"
            ]
          },
          "quote": { "type": "string" },
          "why": { "type": "string" }
        },
        "required": ["type", "quote", "why"]
      }
    },
    "new_genuine_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": { "type": "string" },
          "why": { "type": "string" }
        },
        "required": ["quote", "why"]
      }
    },
    "scam_type": {
      "type": "string",
      "enum": ["DIGITAL_ARREST", "FAKE_KYC", "FAKE_COURIER", "OTHER_FRAUD", "NONE"]
    },
    "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "verdict": { "type": "string", "enum": ["SAFE", "SUSPICIOUS", "SCAM"] },
    "warning_gu": { "type": "string" },
    "warning_hi": { "type": "string" },
    "warning_en": { "type": "string" }
  },
  "required": [
    "transcript",
    "new_red_flags",
    "new_genuine_signals",
    "scam_type",
    "risk_score",
    "verdict",
    "warning_gu",
    "warning_hi",
    "warning_en"
  ]
}
